# Optional unattended bootstrap values. For interactive setup, run
# `uv run engrai-server init` and create an account in the browser instead.
# Do not use the placeholder secrets below as real credentials.
# Seeds are used ONLY to create the credential store on first run. After
# that the store is authoritative and these are ignored — mint keys and change
# the password in the web UI under the avatar menu. Deleting credentials.json
# re-seeds from here, which is also the way to recover a forgotten password.
# Note these stop being the live credentials as soon as either is changed in
# the UI, but they remain what a re-seed would restore. Keep them secret.
# Generate values with: openssl rand -hex 32
ENGRAI_API_KEYS=replace-with-a-long-random-api-key
ENGRAI_ADMIN_TOKEN=replace-with-a-different-long-random-admin-token
ENGRAI_CREDENTIALS_PATH=state/credentials.json

# Relative overrides resolve inside the XDG application layout, never against
# a checkout or the current working directory. ENGRAI_HOME opts into a single
# portable application root.
# ENGRAI_HOME=/opt/engrai-server

# Text and image workers come only from installed, verified ENGRAI runtime
# bundles and are forced onto this private loopback address. They are never
# found on PATH.
ENGRAI_RUNTIME_DIR=runtimes
ENGRAI_ENGINE_HOST=127.0.0.1
ENGRAI_TEXT_ENGINE_PORT=5002
ENGRAI_ROUTE_DIR=routes
ENGRAI_TEXT_ENGINE_LOG=state/text-worker.log
ENGRAI_ENGINE_STOP_TIMEOUT_SECONDS=25
ENGRAI_MODEL_SEARCH_ROOTS=~/.cache/huggingface/hub
ENGRAI_MODEL_DOWNLOAD_DIR=~/.cache/huggingface/hub
# Optional for private or gated repositories. Use a scoped read-only token and
# inject it as an environment secret; ENGRAI never accepts it through the UI.
# HF_TOKEN=hf_...
ENGRAI_MODEL_DOWNLOAD_STATE_PATH=state/model-downloads.json
ENGRAI_MODEL_STATE_PATH=state/runtime.json
ENGRAI_MODEL_LOAD_TIMEOUT_SECONDS=240
