# Created at ~/.config/engrai-server/gateway.env by `engrai-server install`.
# systemd reads this directly: values are literal, with no ~ expansion or shell
# substitution. Relative path overrides resolve within the XDG layout, never
# against the process working directory.

# Where the gateway listens. 127.0.0.1 keeps the control plane private, which
# is right when a tunnel such as cloudflared runs on this same host. Use
# 0.0.0.0 to serve every interface, or pin one address to expose only that
# network. THIS IS USUALLY THE ONLY LINE YOU NEED TO CHANGE.
ENGRAI_BIND_HOST=127.0.0.1
ENGRAI_BIND_PORT=8400

# Peers whose X-Forwarded-* headers are trusted. Set this to your proxy's
# address so the login throttle sees real client IPs rather than the proxy's.
ENGRAI_FORWARDED_ALLOW_IPS=127.0.0.1

# Optional bootstrap credentials. Leave them commented out and the first visit
# to the web UI offers account setup instead — which is the normal path. Set
# them only for an unattended install, and note they stop being the live
# credentials the moment either is changed in the UI.
#ENGRAI_API_KEYS=
#ENGRAI_ADMIN_TOKEN=

# Everything below has a working default. Uncomment only to override.
# Text and image workers come only from `engrai-server runtime install`.
#ENGRAI_ENGINE_HOST=127.0.0.1
#ENGRAI_TEXT_ENGINE_PORT=5002
#ENGRAI_ENGINE_STOP_TIMEOUT_SECONDS=25
#ENGRAI_MODEL_LOAD_TIMEOUT_SECONDS=240
# The model library location is also editable in the profile editor.
#ENGRAI_MODEL_SEARCH_ROOTS=/mnt/bulk/huggingface/hub
# Hugging Face pulls always write here; the browser cannot override this path.
#ENGRAI_MODEL_DOWNLOAD_DIR=/mnt/bulk/huggingface/hub
# Optional for private/gated repositories. Use a scoped read-only token.
#HF_TOKEN=hf_...
