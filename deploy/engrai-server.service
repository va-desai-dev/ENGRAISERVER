[Unit]
Description=ENGRAI SERVER host control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/engrai-server/gateway.env
ExecStart=%h/.local/bin/engrai-server serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=35
UMask=0077

[Install]
WantedBy=default.target
